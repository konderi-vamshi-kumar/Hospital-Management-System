{
  "info": {
    "_postman_id": "04e013a7-6cb2-4763-a9bc-ccb08a86a1d1",
    "name": "Hospital Management System API",
    "description": "Try patient authentication and super-admin hospital onboarding. Run Get CSRF token before state-changing requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "username",
      "value": "hospital_demo"
    },
    {
      "key": "password",
      "value": "LearnJava123!"
    },
    {
      "key": "csrfToken",
      "value": ""
    },
    {
      "key": "superAdminUsername",
      "value": ""
    },
    {
      "key": "superAdminPassword",
      "value": ""
    },
    {
      "key": "hospitalName",
      "value": "Postman Demo Hospital"
    },
    {
      "key": "hospitalId",
      "value": ""
    },
    {
      "key": "adminUsername",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Get CSRF token",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/auth/csrf",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "csrf"
          ]
        },
        "description": "Fetches the CSRF token and sets the matching cookie in Postman's cookie jar."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('CSRF token was issued', function () {",
              "    pm.response.to.have.status(200);",
              "    pm.expect(pm.response.json().token).to.be.a('string');",
              "});",
              "pm.collectionVariables.set('csrfToken', pm.response.json().token);"
            ]
          }
        }
      ]
    },
    {
      "name": "Sign up",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-XSRF-TOKEN",
            "value": "{{csrfToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/signup",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "signup"
          ]
        },
        "description": "Creates a patient account. The password is stored as a BCrypt hash, never as plain text."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Account was created', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "pm.test('Response does not include a password hash', function () {",
              "    pm.expect(pm.response.json()).to.not.have.property('passwordHash');",
              "});",
              "pm.test('Account has the patient role', function () {",
              "    pm.expect(pm.response.json().roles).to.include('PATIENT');",
              "});",
              "pm.collectionVariables.set('username', pm.response.json().username);"
            ]
          }
        }
      ]
    },
    {
      "name": "Sign in",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-XSRF-TOKEN",
            "value": "{{csrfToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/signin",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "signin"
          ]
        },
        "description": "Checks the credentials and starts an HTTP-only session."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Sign in succeeded', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Response does not include a password hash', function () {",
              "    pm.expect(pm.response.json()).to.not.have.property('passwordHash');",
              "});",
              "pm.test('Sign-in created a patient session', function () {",
              "    pm.expect(pm.response.json().roles).to.include('PATIENT');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Current user",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/auth/me",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "me"
          ]
        },
        "description": "Checks the active session and the signed-in user's roles."
      }
    },
    {
      "name": "Sign out",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-XSRF-TOKEN",
            "value": "{{csrfToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/auth/signout",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "signout"
          ]
        },
        "description": "Invalidates the current session."
      }
    },
    {
      "name": "Platform hospital onboarding",
      "description": "Sign in using the configured super-admin account, then onboard the hospital and its resources. The administrator username must already belong to a registered account.",
      "item": [
        {
          "name": "Sign in as super-admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-XSRF-TOKEN",
                "value": "{{csrfToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{superAdminUsername}}\",\n  \"password\": \"{{superAdminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/signin"
            },
            "description": "Set superAdminUsername and superAdminPassword to the values configured for the backend."
          }
        },
        {
          "name": "List hospitals",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/platform/hospitals"
            }
          }
        },
        {
          "name": "Create hospital",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-XSRF-TOKEN",
                "value": "{{csrfToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{hospitalName}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/platform/hospitals"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Hospital was created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.collectionVariables.set('hospitalId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create branch",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-XSRF-TOKEN",
                "value": "{{csrfToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Central Branch\",\n  \"address\": \"12 Main Road\",\n  \"phone\": \"0112345678\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/platform/hospitals/{{hospitalId}}/branches"
            }
          }
        },
        {
          "name": "Create department",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-XSRF-TOKEN",
                "value": "{{csrfToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Cardiology\",\n  \"description\": \"Heart care\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/platform/hospitals/{{hospitalId}}/departments"
            }
          }
        },
        {
          "name": "Assign hospital administrator",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-XSRF-TOKEN",
                "value": "{{csrfToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{adminUsername}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/platform/hospitals/{{hospitalId}}/administrators"
            }
          }
        }
      ]
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (pm.info.requestName === 'Sign up') {",
          "    pm.collectionVariables.set('username', 'hospital_' + Date.now());",
          "}"
        ]
      }
    }
  ]
}
